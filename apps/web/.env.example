VITE_WS_URL=ws://localhost:8787
VITE_API_URL=http://localhost:8788

# Pour consulter le dashboard depuis un autre appareil du LAN (via `vite --host`),
# remplace localhost par l'IP LAN de la machine qui fait tourner le bridge, ex :
# VITE_WS_URL=ws://192.168.31.145:8787
# VITE_API_URL=http://192.168.31.145:8788
